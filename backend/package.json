{
  "name": "tapp-mobile-order-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n checkout,api -c magenta,blue \"npm:dev:checkout\" \"npm:dev:api\"",
